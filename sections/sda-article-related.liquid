{% liquid
  assign picked_handles = '|'
  assign picked_count = 0
  capture related_cards
    for candidate in blog.articles
      assign shares_tag = false
      if candidate.id != article.id
        for tag in candidate.tags
          if article.tags contains tag
            assign shares_tag = true
            break
          endif
        endfor
      endif
      if shares_tag
        assign picked_count = picked_count | plus: 1
        assign picked_handles = picked_handles | append: candidate.handle | append: '|'
        render 'sda-post-card', post: candidate, post_blog: blog, index: picked_count
      endif
      if picked_count == 3
        break
      endif
    endfor
    if picked_count < 3
      for candidate in blog.articles
        assign candidate_key = candidate.handle | prepend: '|' | append: '|'
        if candidate.id != article.id
          unless picked_handles contains candidate_key
            assign picked_count = picked_count | plus: 1
            assign picked_handles = picked_handles | append: candidate.handle | append: '|'
            render 'sda-post-card', post: candidate, post_blog: blog, index: picked_count
          endunless
        endif
        if picked_count == 3
          break
        endif
      endfor
    endif
  endcapture
%}
{% if picked_count > 0 %}
  {{ 'section-sda-article.css' | asset_url | stylesheet_tag }}
  <section class="sda-related color-{{ section.settings.color_scheme }}" aria-labelledby="SdaRelated-{{ section.id }}">
    <div class="sda-related__inner">
      <div class="sda-related__head">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="sda-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          <h2 id="SdaRelated-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        </div>
        {% if section.settings.show_all_link and section.settings.all_link_label != blank -%}
          <a class="sda-related__all" href="{{ blog.url }}">
            {{- section.settings.all_link_label | escape }}
            <span aria-hidden="true">→</span></a
          >
        {%- endif %}
      </div>
      <div class="sda-related__grid">{{ related_cards }}</div>
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name": "SDA related articles",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Keep reading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More from the Alliance" },
    { "type": "checkbox", "id": "show_all_link", "label": "Show all posts link", "default": true },
    {
      "type": "text",
      "id": "all_link_label",
      "label": "All posts link label",
      "default": "All posts",
      "visible_if": "{{ section.settings.show_all_link }}"
    }
  ]
}
{% endschema %}

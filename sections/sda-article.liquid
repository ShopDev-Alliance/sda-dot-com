{% liquid
  assign author_member = article.metafields.custom.author_member.value
  assign author_name = article.author
  assign author_photo = blank
  assign author_role = blank
  assign author_bio = blank
  assign author_url = blank
  assign author_tag = 'span'
  assign member_profile_url = blank
  assign can_comment = false
  assign read_minutes = article.content | strip_html | split: ' ' | size | divided_by: 225 | at_least: 1
  assign title_html = article.title | escape
  assign title_accent = article.metafields.custom.title_accent.value | escape
  assign share_url = canonical_url | url_encode
  assign share_title = article.title | url_encode
  assign hero_type = false
  assign audience = 'developers'
  assign audience_value = article.metafields.custom.audience.value | downcase
  if audience_value == 'merchants'
    assign audience = 'merchants'
  endif
  assign structured_description = article.excerpt | strip_html | strip
  assign structured_image = blank
  assign structured_author_url = blank
  assign structured_logo = blank
  assign structured_published_at = article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z'
  assign structured_updated_at = article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z'
  if structured_description == blank
    assign structured_description = article.content | strip_html | strip | truncate: 160
  endif
  if article.image != blank
    assign structured_image = article.image | image_url: width: 1200 | prepend: 'https:'
  endif
  if settings.logo != blank
    assign structured_logo = settings.logo | image_url: width: 600 | prepend: 'https:'
  endif
  if article.user != blank
    assign author_name = article.user.name | default: author_name
    assign author_photo = article.user.image
    assign author_bio = article.user.bio
    assign author_url = article.user.homepage
  endif
  if author_member != blank
    assign author_name = author_member.name.value | default: author_name
    assign author_photo = author_member.profile_photo.value | default: author_photo
    assign author_role = author_member.tagline.value
    if author_member.description != blank
      assign author_bio = author_member.description | metafield_text
    endif
    assign author_url = blank
    if author_member.profile.value == true
      assign member_profile_url = author_member.system.url
      assign author_url = member_profile_url
      assign structured_author_url = shop.url | append: member_profile_url
    endif
  endif
  # Promote the first valid co-author only when every lead fallback is blank.
  assign co_authors = article.metafields.custom.co_authors.value
  assign author_count = 0
  if author_name != blank
    assign author_count = 1
  endif
  if co_authors.count > 0
    for co_author in co_authors
      if co_author.name.value == blank or co_author.system.handle == author_member.system.handle
        continue
      endif
      if author_name == blank
        assign author_member = co_author
        assign author_name = co_author.name.value
        assign author_photo = co_author.profile_photo.value
        assign author_role = co_author.tagline.value
        assign author_bio = blank
        assign author_url = blank
        assign structured_author_url = blank
        if co_author.description != blank
          assign author_bio = co_author.description | metafield_text
        endif
        if co_author.profile.value == true
          assign author_url = co_author.system.url
          assign structured_author_url = shop.url | append: author_url
        endif
      endif
      assign author_count = author_count | plus: 1
    endfor
  endif
  assign compact_authors = false
  assign hero_avatar_count = 1
  assign other_author_count = author_count | minus: 1
  assign authors_and = 'blogs.article.authors_and' | t
  assign other_authors_label = blank
  if author_count >= 4
    assign compact_authors = true
    assign other_authors_label = 'blogs.article.authors_others' | t: count: other_author_count
  endif
  if author_url != blank
    assign author_tag = 'a'
  endif
  if title_accent != blank and title_html contains title_accent
    assign accent_markup = title_accent | prepend: '<em>' | append: '</em>'
    assign title_html = title_html | replace_first: title_accent, accent_markup
  endif
  if article.image == blank and section.settings.no_image_style == 'none'
    assign hero_type = true
  endif
  if section.settings.comments_members_only == false
    assign can_comment = true
  elsif customer.metafields.custom.sda_member == true
    assign can_comment = true
  endif
%}

{{ 'section-sda-article.css' | asset_url | stylesheet_tag }}

<sda-article
  class="sda-article color-{{ section.settings.color_scheme }}{% if section.settings.show_drop_cap %} sda-article--drop-cap{% endif %}"
  data-copy="{{ 'blogs.article.copy' | t | escape }}"
  data-copied="{{ 'blogs.article.copied' | t | escape }}"
  data-copy-error="{{ 'blogs.article.copy_error' | t | escape }}"
  data-heading-label="{{ 'blogs.article.copy_section' | t | escape }}"
  data-note="{{ 'blogs.article.note' | t | escape }}"
  data-tip="{{ 'blogs.article.tip' | t | escape }}"
  data-warning="{{ 'blogs.article.warning' | t | escape }}"
>
  <nav class="sda-crumbs" aria-label="{{ 'blogs.article.breadcrumb' | t | escape }}">
    <a href="{{ routes.root_url }}">{{ 'blogs.article.home' | t }}</a><span aria-hidden="true">/</span>
    <a href="{{ blog.url }}">{{ blog.title | escape }}</a><span aria-hidden="true">/</span>
    <span class="sda-crumbs__current" aria-current="page">{{ article.title | escape }}</span>
  </nav>
  <header class="sda-hero{% if hero_type %} sda-hero--type{% endif %}">
    <div class="sda-tags">
      <a class="sda-tag sda-tag--accent" href="{{ blog.url }}">{{ blog.title | escape }}</a>
      {% if article.metafields.custom.audience.value != blank %}
        <span class="sda-tag sda-tag--accent">
          {% if audience == 'merchants' %}
            {{ 'blogs.article.for_merchants' | t }}
          {% else %}
            {{ 'blogs.article.for_developers' | t }}
          {% endif %}
        </span>
      {% endif %}
      {% for tag in article.tags %}
        <a class="sda-tag" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a>
      {% endfor %}
    </div>
    <h1 class="sda-hero__title">{{ title_html }}</h1>
    {% if article.excerpt != blank %}
      <div class="sda-hero__dek">{{ article.excerpt }}</div>
    {% endif %}
    <div class="sda-hero__meta">
      {% if author_count > 1 %}
        <div class="sda-author sda-author--multi">
          <span class="sda-avatar-stack">
            {% render 'sda-avatar', name: author_name, photo: author_photo, size: 42, loading: 'eager' %}
            {% for co_author in co_authors %}
              {% liquid
                if co_author.name.value == blank or co_author.system.handle == author_member.system.handle
                  continue
                endif
                if hero_avatar_count == 4
                  break
                endif
                assign hero_avatar_count = hero_avatar_count | plus: 1
              %}
              {% render 'sda-avatar', name: co_author.name.value, photo: co_author.profile_photo.value, size: 42, loading: 'eager' %}
            {% endfor %}
          </span>
          <span class="sda-author__name">
            {%- if author_url != blank -%}
              <a href="{{ author_url | escape }}">{{ author_name | escape }}</a>
            {%- else -%}
              {{- author_name | escape -}}
            {%- endif -%}
            {%- if compact_authors %}
              {{ authors_and }}
              {% if section.settings.show_author_card %}
                <a href="#authors">{{ other_authors_label | escape }}</a>
              {% else %}
                {{ other_authors_label | escape }}
              {% endif %}
            {% else %}
              {%- liquid
                assign author_index = 1
              -%}
              {%- for co_author in co_authors -%}
                {%- liquid
                  if co_author.name.value == blank or co_author.system.handle == author_member.system.handle
                    continue
                  endif
                  assign author_index = author_index | plus: 1
                -%}
                {%- if author_index == author_count %} {{ 'blogs.article.authors_and' | t }} {% else %}, {% endif -%}
                {%- if co_author.profile.value == true and co_author.system.url != blank -%}
                  <a href="{{ co_author.system.url | escape }}">{{ co_author.name.value | escape }}</a>
                {%- else -%}
                  {{- co_author.name.value | escape -}}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </span>
        </div>
      {% elsif author_count == 1 %}
        <{{ author_tag }}
          class="sda-author"
          {% if author_url != blank %}
            href="{{ author_url | escape }}"
          {% endif %}
        >
          {% render 'sda-avatar', name: author_name, photo: author_photo, size: 42, loading: 'eager' %}
          <span
            ><span class="sda-author__name">{{ author_name | escape }}</span>
            {%- if author_role != blank -%}
              <span class="sda-author__role">{{ author_role | escape }}</span>
            {%- endif -%}
          </span>
        </{{ author_tag }}>
      {% endif %}
      <span class="sda-meta">{{ article.published_at | time_tag: format: 'date' }}</span>
      <span class="sda-meta">{{ 'blogs.article.read_minutes' | t: count: read_minutes }}</span>
    </div>
    {% if article.image != blank %}
      <div class="sda-hero__image">
        {{
          article.image
          | image_url: width: 2400
          | image_tag:
            widths: '375, 750, 1100, 1600, 2400',
            sizes: '(min-width: 1200px) 1144px, calc(100vw - 56px)',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      </div>
    {% elsif section.settings.no_image_style == 'gradient' %}
      <div class="sda-hero__image sda-hero__image--gradient" aria-hidden="true"></div>
    {% endif %}
  </header>
  <div class="sda-article__layout">
    <div class="sda-article__column">
      <div class="sda-article__body">{{ article.content }}</div>
      {% if section.settings.show_author_card %}
        {% if author_count > 0 %}
          <div class="sda-author-cards{% if compact_authors %} sda-author-cards--grid{% endif %}"{% if compact_authors %} id="authors"{% endif %}>
            {% if compact_authors %}
              <h2 class="sda-author-cards__heading">{{ 'blogs.article.contributors' | t }}</h2>
            {% endif %}
            {% render 'sda-author-card', name: author_name, photo: author_photo, bio: author_bio, url: author_url, member: author_member, role: author_role, compact: compact_authors %}
            {% for co_author in co_authors %}
              {% liquid
                if co_author.name.value == blank or co_author.system.handle == author_member.system.handle
                  continue
                endif
                assign co_author_bio = blank
                assign co_author_url = blank
                if co_author.description != blank
                  assign co_author_bio = co_author.description | metafield_text
                endif
                if co_author.profile.value == true
                  assign co_author_url = co_author.system.url
                endif
              %}
              {% render 'sda-author-card', name: co_author.name.value, photo: co_author.profile_photo.value, bio: co_author_bio, url: co_author_url, member: co_author, role: co_author.tagline.value, compact: compact_authors %}
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    </div>
    <aside class="sda-rail">
      <div class="sda-rail__progress" data-rail-progress hidden>
        <div class="sda-rail__progress-label">
          <span class="sda-rail__percent" data-read-percent>0%</span>
          <span class="sda-rail__read">{{ 'blogs.article.read' | t }}</span>
        </div>
        <div class="sda-rail__track" aria-hidden="true"><div class="sda-rail__fill"></div></div>
      </div>
      <nav class="sda-rail__group" data-toc-group hidden aria-label="{{ 'blogs.article.on_this_page' | t | escape }}">
        <button
          class="sda-rail__toggle"
          type="button"
          data-action="toggle-toc"
          aria-expanded="true"
          aria-controls="SdaToc-{{ section.id }}"
        >
          {{ 'blogs.article.on_this_page' | t -}}
          <span aria-hidden="true">⌄</span>
        </button>
        <ol class="sda-toc-list" id="SdaToc-{{ section.id }}" data-toc></ol>
      </nav>
      {% if section.settings.show_share %}
        <div class="sda-rail__group">
          <h2 class="sda-eyebrow">{{ 'blogs.article.share' | t }}</h2>
          <div class="sda-share">
            <a
              href="https://twitter.com/intent/tweet?text={{ share_title }}&amp;url={{ share_url }}"
              target="_blank"
              rel="noopener"
            >
              {{- 'blogs.article.twitter' | t -}}
            </a>
            <a
              href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url }}"
              target="_blank"
              rel="noopener"
            >
              {{- 'blogs.article.linked_in' | t -}}
            </a>
            <button type="button" data-action="copy-link" hidden>{{ 'blogs.article.copy_link' | t }}</button>
          </div>
        </div>
      {% endif %}
      {% if article.tags.size > 0 %}
        <div class="sda-rail__group">
          <h2 class="sda-eyebrow">{{ 'blogs.article.filed_under' | t }}</h2>
          <div class="sda-tags">
            {% for tag in article.tags -%}
              <a class="sda-tag" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a>
            {%- endfor %}
          </div>
        </div>
      {% endif %}
    </aside>
  </div>

  {% if blog.comments_enabled? %}
    {% comment %}Display gating only: the comment endpoint is public. Keep this blog moderated.{% endcomment %}
    <section class="sda-comments" id="comments" aria-labelledby="SdaComments-{{ section.id }}">
      <div class="sda-comments__inner">
        <h2 id="SdaComments-{{ section.id }}">{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
        {% paginate article.comments by 20 %}
          {% if comment.status == 'pending' and comment.content %}
            <article class="sda-comment" id="{{ comment.id }}">
              <span class="sda-avatar" aria-hidden="true">{{ comment.author | slice: 0 | upcase | escape }}</span>
              <div>
                <div class="sda-comment__head">
                  <strong>{{ comment.author | escape }}</strong
                  ><span class="sda-meta">{{ comment.created_at | time_tag: format: 'date' }}</span>
                </div>
                {{ comment.content }}
              </div>
            </article>
          {% endif %}
          {% for comment in article.comments %}
            {% liquid
              # Whole-name comparisons also handle names containing delimiter characters.
              assign comment_is_author = false
              if author_name != blank and comment.author == author_name
                assign comment_is_author = true
              endif
              for co_author in co_authors
                if co_author.name.value == blank or co_author.system.handle == author_member.system.handle
                  continue
                endif
                if comment.author == co_author.name.value
                  assign comment_is_author = true
                  break
                endif
              endfor
              assign comment_words = comment.author | split: ' '
              assign comment_initials = comment_words.first | slice: 0 | upcase
              if comment_words.size > 1
                assign comment_last_initial = comment_words.last | slice: 0 | upcase
                assign comment_initials = comment_initials | append: comment_last_initial
              endif
            %}
            <article class="sda-comment" id="{{ comment.id }}">
              <span class="sda-avatar" aria-hidden="true">{{ comment_initials | escape }}</span>
              <div>
                <div class="sda-comment__head">
                  <strong>{{ comment.author | escape }}</strong>
                  {%- if comment_is_author -%}
                    <span class="sda-comment__badge">{{ 'blogs.article.author_badge' | t }}</span>
                  {%- endif -%}
                  <span class="sda-meta">{{ comment.created_at | time_tag: format: 'date' }}</span>
                </div>
                {{ comment.content }}
              </div>
            </article>
          {% endfor %}
          {% if paginate.pages > 1 %}
            <nav class="sda-pagination" aria-label="{{ 'general.pagination.label' | t | escape }}">
              {% if paginate.previous -%}
                <a
                  href="{{ paginate.previous.url }}#comments"
                  aria-label="{{ 'general.pagination.previous' | t | escape }}"
                  >←</a
                >
              {%- endif %}
              {% for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a
                    href="{{ part.url }}#comments"
                    aria-label="{{ 'general.pagination.page' | t: number: part.title | escape }}"
                  >
                    {{- part.title -}}
                  </a>
                {%- else -%}
                  <span
                    {% if part.title == paginate.current_page %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- part.title -}}
                  </span>
                {%- endif -%}
              {%- endfor %}
              {% if paginate.next -%}
                <a href="{{ paginate.next.url }}#comments" aria-label="{{ 'general.pagination.next' | t | escape }}">→</a>
              {%- endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
        {% if can_comment %}
          {% form 'new_comment', article, class: 'sda-comment-form' %}
            {% liquid
              assign post_message = 'blogs.article.success'
              if blog.moderated? and comment.status == 'unapproved'
                assign post_message = 'blogs.article.success_moderated'
              endif
            %}
            <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>
            {% if form.errors %}
              <div class="sda-form-status" role="alert" tabindex="-1" autofocus>
                <h3>{{ 'templates.contact.form.error_heading' | t }}</h3>
                <ul>
                  {% for field in form.errors %}
                    <li>
                      {% if section.settings.comments_members_only and field != 'body' -%}
                        {{- form.errors.translated_fields[field] }}
                        {{ form.errors.messages[field] -}}
                      {%- else -%}
                        <a href="#SdaComment-{{ section.id }}-{{ field }}">
                          {{- form.errors.translated_fields[field] }}
                          {{ form.errors.messages[field] -}}
                        </a>
                      {%- endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% elsif form.posted_successfully? %}
              <p class="sda-form-status" role="status" tabindex="-1" autofocus>{{ post_message | t }}</p>
            {% endif %}
            {% if section.settings.comments_members_only %}
              <input type="hidden" name="comment[author]" value="{{ customer.name | escape }}">
              <input type="hidden" name="comment[email]" value="{{ customer.email | escape }}">
            {% else %}
              <div class="sda-comment-form__fields">
                <div>
                  <label for="SdaComment-{{ section.id }}-author">
                    {{- 'blogs.article.name' | t }}
                    <span aria-hidden="true">*</span></label
                  ><input
                    type="text"
                    name="comment[author]"
                    id="SdaComment-{{ section.id }}-author"
                    value="{{ form.author | escape }}"
                    autocomplete="name"
                    required
                    aria-required="true"
                    {% if form.errors contains 'author' %}
                      aria-invalid="true" aria-describedby="SdaComment-{{ section.id }}-author-error"
                    {% endif %}
                  >
                  {%- if form.errors contains 'author' -%}
                    <small id="SdaComment-{{ section.id }}-author-error">{{ form.errors.messages.author }}</small>
                  {%- endif %}
                </div>
                <div>
                  <label for="SdaComment-{{ section.id }}-email">
                    {{- 'blogs.article.email' | t }}
                    <span aria-hidden="true">*</span></label
                  ><input
                    type="email"
                    name="comment[email]"
                    id="SdaComment-{{ section.id }}-email"
                    value="{{ form.email | escape }}"
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    required
                    aria-required="true"
                    {% if form.errors contains 'email' %}
                      aria-invalid="true" aria-describedby="SdaComment-{{ section.id }}-email-error"
                    {% endif %}
                  >
                  {%- if form.errors contains 'email' -%}
                    <small id="SdaComment-{{ section.id }}-email-error">{{ form.errors.messages.email }}</small>
                  {%- endif %}
                </div>
              </div>
            {% endif %}
            <label for="SdaComment-{{ section.id }}-body">
              {{- 'blogs.article.message' | t }}
              <span aria-hidden="true">*</span></label
            >
            <textarea
              rows="5"
              name="comment[body]"
              id="SdaComment-{{ section.id }}-body"
              required
              aria-required="true"
              {% if form.errors contains 'body' %}
                aria-invalid="true" aria-describedby="SdaComment-{{ section.id }}-body-error"
              {% endif -%}
            >{{ form.body | escape }}</textarea>
            {% if form.errors contains 'body' -%}
              <small id="SdaComment-{{ section.id }}-body-error">{{ form.errors.messages.body }}</small>
            {%- endif %}
            {% if blog.moderated? %}
              <p class="sda-meta">{{ 'blogs.article.moderated' | t }}</p>
            {% endif %}
            <button type="submit" class="sda-comment-form__submit button">{{ 'blogs.article.post' | t }}</button>
          {% endform %}
        {% else %}
          <p class="sda-comments__prompt">
            {{ 'blogs.article.members_prompt' | t }}
            <a href="{{ routes.account_login_url }}">{{ 'blogs.article.log_in' | t }}</a>
            {%- if section.settings.join_url != blank %}
              {{ 'blogs.article.or' | t }}
              <a href="{{ section.settings.join_url }}">{{ 'blogs.article.join' | t }}</a>
            {%- endif -%}
            .
          </p>
        {% endif %}
      </div>
    </section>
  {% endif %}
  <button
    class="sda-reading-bar"
    type="button"
    data-action="open-contents"
    data-visible="false"
    aria-expanded="false"
    aria-controls="SdaContents-{{ section.id }}"
    aria-label="{{ 'blogs.article.open_contents_sharing' | t | escape }}"
    inert
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M8 6h13M8 12h13M8 18h13M3 6h1M3 12h1M3 18h1"/>
    </svg>
    <span class="sda-reading-bar__label" data-contents-label>{{ 'blogs.article.contents' | t }}</span>
    <span class="sda-reading-bar__percent" data-bar-percent>0%</span>
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="m6 15 6-6 6 6"/>
    </svg>
    <span class="sda-reading-bar__progress" aria-hidden="true"></span>
  </button>
  <dialog class="sda-contents" id="SdaContents-{{ section.id }}" aria-labelledby="SdaContentsTitle-{{ section.id }}">
    <div class="sda-contents__head">
      <h2 id="SdaContentsTitle-{{ section.id }}">{{ 'blogs.article.contents_sharing' | t }}</h2>
      <button type="button" data-action="close-contents" aria-label="{{ 'accessibility.close' | t | escape }}">
        ×
      </button>
    </div>
    <div class="sda-contents__group" data-mobile-toc-group hidden>
      <h3 class="sda-eyebrow">{{ 'blogs.article.on_this_page' | t }}</h3>
      <nav data-mobile-toc aria-label="{{ 'blogs.article.on_this_page' | t | escape }}"></nav>
    </div>
    {% if section.settings.show_share %}
      <div class="sda-contents__group">
        <h3 class="sda-eyebrow">{{ 'blogs.article.share' | t }}</h3>
        <div class="sda-share sda-share--tray">
          <a
            href="https://twitter.com/intent/tweet?text={{ share_title }}&amp;url={{ share_url }}"
            target="_blank"
            rel="noopener"
          >
            {{- 'blogs.article.twitter' | t -}}
          </a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url }}" target="_blank" rel="noopener">
            {{- 'blogs.article.linked_in' | t -}}
          </a>
          <button type="button" data-action="copy-link">{{ 'blogs.article.copy_link' | t }}</button>
        </div>
      </div>
    {% endif %}
    {% if article.tags.size > 0 %}
      <div class="sda-contents__group">
        <h3 class="sda-eyebrow">{{ 'blogs.article.filed_under' | t }}</h3>
        <div class="sda-tags">
          {% for tag in article.tags %}
            <a class="sda-tag" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a>
          {% endfor %}
        </div>
      </div>
    {% endif %}
    <div class="sda-contents__actions">
      <button type="button" data-action="top">{{ 'blogs.article.back_to_top' | t }}</button>
    </div>
    <p class="sda-sr-only" data-dialog-status role="status" aria-live="polite"></p>
  </dialog>
  <button
    class="sda-back-to-top"
    type="button"
    data-action="top"
    aria-label="{{ 'blogs.article.back_to_top' | t | escape }}"
    hidden
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </button>
  <p class="sda-sr-only" data-status role="status" aria-live="polite"></p>
</sda-article>

<script src="{{ 'sda-article.js' | asset_url }}" defer="defer"></script>
<script type="application/ld+json">
  {
    "@context": {{ 'https://schema.org' | json }},
    "@type": {{ 'BlogPosting' | json }},
    "headline": {{ article.title | json }},
    "description": {{ structured_description | json }},
    {% if structured_image != blank %}
      "image": {{ structured_image | json }},
    {% endif %}
    "datePublished": {{ structured_published_at | json }},
    "dateModified": {{ structured_updated_at | json }},
    "author": {% if author_count > 1 %}[{% endif %}
    {
      "@type": {{ 'Person' | json }},
      "name": {{ author_name | json }}
      {% if structured_author_url != blank %}, "url": {{ structured_author_url | json }}{% endif %}
    }
    {% for co_author in co_authors %}
      {% liquid
        if co_author.name.value == blank or co_author.system.handle == author_member.system.handle
          continue
        endif
      %}
      , {
        "@type": {{ 'Person' | json }},
        "name": {{ co_author.name.value | json }}
        {% if co_author.profile.value == true and co_author.system.url != blank %}
          , "url": {{ shop.url | append: co_author.system.url | json }}
        {% endif %}
      }
    {% endfor %}
    {% if author_count > 1 %}]{% endif %},
    "publisher": {
      "@type": {{ 'Organization' | json }},
      "name": {{ shop.name | json }}
      {% if structured_logo != blank %}
        , "logo": {
          "@type": {{ 'ImageObject' | json }},
          "url": {{ structured_logo | json }}
        }
      {% endif %}
    },
    "mainEntityOfPage": {{ canonical_url | json }}
  }
</script>

{% schema %}
{
  "name": "SDA article",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "no_image_style",
      "label": "When there is no featured image",
      "default": "gradient",
      "options": [
        { "value": "gradient", "label": "Gradient band" },
        { "value": "none", "label": "Large title, no media" }
      ]
    },
    { "type": "checkbox", "id": "show_drop_cap", "label": "Show lead paragraph drop cap", "default": true },
    { "type": "checkbox", "id": "show_author_card", "label": "Show author card", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show sharing links", "default": true },
    {
      "type": "paragraph",
      "content": "Comments appear only when enabled on the blog. Member restrictions control display only; keep the blog moderated."
    },
    {
      "type": "checkbox",
      "id": "comments_members_only",
      "label": "Show comment form to members only",
      "default": true
    },
    {
      "type": "url",
      "id": "join_url",
      "label": "Join page",
      "visible_if": "{{ section.settings.comments_members_only }}"
    }
  ]
}
{% endschema %}

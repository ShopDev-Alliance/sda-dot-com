{% doc %}
  Renders one author card with an optional profile link and member socials.

  @param {string} name - Resolved author name.
  @param {image} [photo] - Author photo.
  @param {string} [bio] - Author biography.
  @param {string} [url] - Author profile URL.
  @param {metaobject} [member] - Member providing social links.
  @param {string} [role] - Member tagline for compact cards.
  @param {boolean} [compact] - Use a smaller avatar, h3, and tagline without socials.
{% enddoc %}
{% liquid
  assign heading_tag = 'h2'
  assign avatar_size = 72
  assign avatar_class = 'sda-avatar--large'
  if compact
    assign heading_tag = 'h3'
    assign avatar_size = 56
    assign avatar_class = 'sda-avatar--compact'
  endif
  assign social_fields = 'twitter,linked_in,github,website' | split: ','
%}
<div class="sda-author-card{% if compact %} sda-author-card--compact{% endif %}">
  {% render 'sda-avatar', name: name, photo: photo, size: avatar_size, loading: 'lazy', class: avatar_class %}
  <div>
    <{{ heading_tag }} class="sda-author-card__name">
      {% if url != blank -%}
        <a class="sda-author-card__profile" href="{{ url | escape }}">{{ name | escape }}</a>
      {%- else -%}
        {{- name | escape -}}
      {%- endif %}
    </{{ heading_tag }}>
    {% if compact %}
      {% if role != blank %}
        <p class="sda-author-card__bio">{{ role | escape }}</p>
      {% endif %}
    {% elsif bio != blank %}
      <p class="sda-author-card__bio">{{ bio | strip_html | truncate: 240 | escape }}</p>
    {% endif %}
  </div>
  {% if member != blank and compact != true %}
    <div class="sda-author-card__socials">
      {% for social_field in social_fields %}
        {% liquid
          assign social_url = member[social_field].value
          assign social_label = blank
          case social_field
            when 'twitter'
              assign social_label = 'blogs.article.twitter' | t
            when 'linked_in'
              assign social_label = 'blogs.article.linked_in' | t
            when 'github'
              assign social_label = 'blogs.article.github' | t
            when 'website'
              assign social_label = 'blogs.article.website' | t
          endcase
        %}
        {% if social_url != blank %}
          <a
            href="{{ social_url | escape }}"
            target="_blank"
            rel="noopener"
            aria-label="{{ social_label | escape }}"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              {% case social_field %}
                {% when 'twitter' %}<path d="m4 4 16 16M20 4 4 20M4 4h5l11 16h-5Z"/>
                {% when 'linked_in' %}<path d="M5 9v11M5 4v1M10 20V9h4v2c4-5 7-1 7 2v7M14 20v-7"/>
                {% when 'github' %}<path d="M9 20c-5 2-5-3-7-3m15 5v-4c0-1-.3-2-1-2 4-.5 6-2 6-6 0-2-1-3-2-4 0-1 0-3-1-4-2 0-4 2-4 2a15 15 0 0 0-6 0S7 2 5 2C4 3 4 5 4 6c-1 1-2 2-2 4 0 4 2 5.5 6 6-1 1-1 2-1 3v3"/>
                {% else %}<circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/>
              {% endcase %}
            </svg>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>

{% doc %}
  Prints the article reading time with no surrounding whitespace.

  @param {article} post - Article to measure.
{% enddoc %}
{%- liquid
  assign read_minutes = post.content | strip_html | split: ' ' | size | divided_by: 225 | at_least: 1
  echo 'blogs.article.read_minutes' | t: count: read_minutes
-%}
